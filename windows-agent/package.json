{
  "name": "teammonitor-agent",
  "version": "1.0.0",
  "description": "TeamMonitor Agent for Windows",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "dependencies": {
    "electron-store": "^8.1.0"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.alphabyte.teammonitor",
    "productName": "TeamMonitor Agent",
    "copyright": "© 2026 AlphaByte Innovations",
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true
    },
    "files": ["**/*", "!node_modules/.cache"],
    "extraResources": [],
    "asar": true
  }
}
